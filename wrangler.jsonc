// Cloudflare Workers static-assets deployment for tylerrouze.com.
// `pnpm build` outputs the site to dist/ which is served directly —
// no worker script is needed for a fully static site.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tylerrouze-com",
	"compatibility_date": "2026-10-07",
	"assets": {
		"directory": "./dist",
		// Serve /404.html with a 404 status for unknown routes (Astro emits it)
		"not_found_handling": "404-page",
		// /about.html redirects to /about, /about serves content directly
		"html_handling": "auto-trailing-slash",
	},
	// Provisions/updates the proxied DNS records for these hostnames on
	// deploy. Any pre-existing DNS records for these hostnames must be
	// deleted first (the API won't replace them — error 100117).
	"routes": [
		{ "pattern": "tylerrouze.com", "custom_domain": true },
		{ "pattern": "www.tylerrouze.com", "custom_domain": true }
	],
}
